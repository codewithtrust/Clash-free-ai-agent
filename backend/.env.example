# Copy this file to .env and fill in what you need.
# Everything works without keys using the deterministic parser and demo data.

APP_ENV=development
DATABASE_URL=sqlite:///data/clashfree.db

# OpenAI-compatible multimodal extraction (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For Azure/OpenAI-compatible gateways:
# OPENAI_BASE_URL=

# Google Calendar OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/google/callback
FRONTEND_URL=http://localhost:5173

# Email digest (optional). Without SMTP the digest is written to data/outbox/*.eml.
NOTIFICATIONS_TO=buddy@northfield.edu
NOTIFICATIONS_FROM=clashfree@northfield.edu
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
SMTP_USE_SSL=0

# Set to 1 to attempt Playwright if a page has very little readable text.
ENABLE_PLAYWRIGHT=0
